# ALRA TRAINING INSTITUTE LTD/GTE — website configuration
# Copy to .env.local and fill in real values before launch.

# Public company contact details (shown on Contact page + footer)
NEXT_PUBLIC_SITE_URL="https://your-domain.example"
NEXT_PUBLIC_COMPANY_NAME="ALRA TRAINING INSTITUTE LTD/GTE"
NEXT_PUBLIC_COMPANY_EMAIL="adedureo@gmail.com"
NEXT_PUBLIC_COMPANY_PHONE="+39 389 458 4635"
NEXT_PUBLIC_COMPANY_ADDRESS="10 Journalist Estate Road, Arepo, Ogun State, Nigeria"
NEXT_PUBLIC_COMPANY_HOURS="Monday–Friday, 8:00–17:00 (WAT)"

# WhatsApp number in international format, using digits only (no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER="393894584635"

# Optional: link to a hosted brochure PDF. Leave blank to hide brochure links.
NEXT_PUBLIC_BROCHURE_URL=""

# Required in production: deliver enquiries to an email/CRM webhook.
# Use a secure server endpoint from Formspree, Make, Zapier or your own backend.
ENQUIRY_WEBHOOK_URL=""

# Spam protection: minimum seconds a human should take to fill the form
ENQUIRY_MIN_FILL_SECONDS="4"
